# Public values only. Copy to .env.local for local development, or set these two on Netlify.
# Find both in Supabase: Project Settings > API. Use the "anon" / "publishable" key.
# NEVER put the service_role or secret key here or anywhere in this app. `npm run validate` fails if one is found.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Schedule reading (PDF/photo upload) needs an Anthropic key ON THE SERVER ONLY.
# Set ANTHROPIC_API_KEY in Netlify > Environment variables with the Functions scope. Do not put it in this
# file and never give it a VITE_ prefix: that would ship it to every browser. `npm run validate` fails if one is found.
