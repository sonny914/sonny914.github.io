# Public values only. Copy to .env.local for local development, or set these two on Netlify.
# Find both in Supabase: Project Settings > API. Use the "anon" / "publishable" key.
# NEVER put the service_role or secret key here or anywhere in this app. `npm run validate` fails if one is found.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
